#!/bin/bash

# Ultra-Compact GPU Monitor for Small Screens
# Usage: ./gpu-watch-compact [interval_seconds]

INTERVAL=${1:-1}

# Get the directory where the script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CSV_FILE="$SCRIPT_DIR/gpu_monitor_log.csv"

# Track session start time
SESSION_START=$(date +%s)

# Declare associative arrays for tracking GPU status
declare -A GPU_ONLINE_TIME
declare -A GPU_FAIL_TIME
declare -A GPU_TOTAL_UPTIME
declare -A GPU_STATUS

# Create CSV header if file doesn't exist
if [ ! -f "$CSV_FILE" ]; then
    echo "Timestamp,GPU_Index,GPU_Name,Temp_C,Core_MHz,Mem_MHz,Power_W,Util_%,Mem_Used_MB,Mem_Total_MB,PID,Process_Name,Process_CWD,Process_Mem_MB,GPU_Status" > "$CSV_FILE"
fi

# Function to format seconds as HH:MM:SS
format_time() {
    local seconds=$1
    printf "%02d:%02d:%02d" $((seconds/3600)) $((seconds%3600/60)) $((seconds%60))
}

# Function to check GPU health and update status
check_gpu_health() {
    local current_time=$(date +%s)
    
    # Get list of GPUs and their status
    nvidia-smi --query-gpu=index,name --format=csv,noheader,nounits 2>&1 | while IFS=',' read -r idx name; do
        idx=$(echo "$idx" | xargs)
        
        # Check if GPU is accessible or has errors
        GPU_QUERY=$(nvidia-smi -i "$idx" --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>&1)
        
        # Initialize arrays if not set
        if [ -z "${GPU_ONLINE_TIME[$idx]}" ]; then
            GPU_ONLINE_TIME[$idx]=$current_time
            GPU_TOTAL_UPTIME[$idx]=0
            GPU_STATUS[$idx]="online"
        fi
        
        # Check for GPU errors
        if echo "$GPU_QUERY" | grep -qi "error\|reset\|unable\|failed"; then
            if [ "${GPU_STATUS[$idx]}" = "online" ]; then
                # GPU just failed
                GPU_FAIL_TIME[$idx]=$current_time
                # Add to total uptime
                GPU_TOTAL_UPTIME[$idx]=$((GPU_TOTAL_UPTIME[$idx] + current_time - GPU_ONLINE_TIME[$idx]))
                GPU_STATUS[$idx]="failed"
            fi
        else
            if [ "${GPU_STATUS[$idx]}" = "failed" ]; then
                # GPU came back online
                GPU_ONLINE_TIME[$idx]=$current_time
                GPU_STATUS[$idx]="online"
            fi
        fi
    done
}

# Function to log GPU data to CSV
log_to_csv() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Query all GPU data
    nvidia-smi --query-gpu=index,name,temperature.gpu,clocks.gr,clocks.mem,power.draw,utilization.gpu,memory.used,memory.total \
        --format=csv,noheader,nounits 2>/dev/null | while IFS=',' read -r idx name temp core memclk power util mem_used mem_total; do
        
        # Trim whitespace
        idx=$(echo "$idx" | xargs)
        name=$(echo "$name" | xargs)
        temp=$(echo "$temp" | xargs)
        core=$(echo "$core" | xargs)
        memclk=$(echo "$memclk" | xargs)
        power=$(echo "$power" | xargs)
        util=$(echo "$util" | xargs)
        mem_used=$(echo "$mem_used" | xargs)
        mem_total=$(echo "$mem_total" | xargs)
        
        local gpu_status="${GPU_STATUS[$idx]:-online}"
        
        # Get PIDs and process info running on this GPU
        PID_INFO=$(nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader -i "$idx" 2>/dev/null)
        
        if [ -n "$PID_INFO" ]; then
            # Log each process separately
            echo "$PID_INFO" | while IFS=',' read -r pid proc_name proc_mem; do
                pid=$(echo "$pid" | xargs)
                proc_name=$(echo "$proc_name" | xargs)
                proc_mem=$(echo "$proc_mem" | xargs)
                
                # Get working directory
                cwd=""
                if [ -d "/proc/$pid" ]; then
                    cwd=$(readlink /proc/$pid/cwd 2>/dev/null || echo "")
                fi
                
                # Escape any commas in the data
                name_clean=$(echo "$name" | sed 's/,/_/g')
                proc_name_clean=$(echo "$proc_name" | sed 's/,/_/g')
                cwd_clean=$(echo "$cwd" | sed 's/,/_/g')
                
                echo "$timestamp,$idx,$name_clean,$temp,$core,$memclk,$power,$util,$mem_used,$mem_total,$pid,$proc_name_clean,$cwd_clean,$proc_mem,$gpu_status" >> "$CSV_FILE"
            done
        else
            # Log GPU with no processes
            name_clean=$(echo "$name" | sed 's/,/_/g')
            echo "$timestamp,$idx,$name_clean,$temp,$core,$memclk,$power,$util,$mem_used,$mem_total,,,,,,$gpu_status" >> "$CSV_FILE"
        fi
    done
}

show_gpus() {
    # Move cursor to top-left instead of clearing (reduces flicker)
    tput cup 0 0
    
    local current_time=$(date +%s)
    local session_uptime=$((current_time - SESSION_START))
    
    # Get driver and CUDA version
    DRIVER_VERSION=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -n 1 | xargs 2>/dev/null)
    # Get CUDA version from nvidia-smi output
    CUDA_VERSION=$(nvidia-smi | grep "CUDA Version" | awk '{print $9}' | head -n 1 2>/dev/null)
    if [ -z "$CUDA_VERSION" ]; then
        CUDA_VERSION="N/A"
    fi
    
    echo -n "GPU Monitor - $(date +%H:%M:%S) | Session: $(format_time $session_uptime)"
    tput el
    echo ""
    echo -n "Driver: $DRIVER_VERSION | CUDA: $CUDA_VERSION"
    tput el
    echo ""
    echo -n "Log: $(basename $CSV_FILE)"
    tput el
    echo ""
    echo -n "--------------------------------"
    tput el
    echo ""
    
    nvidia-smi --query-gpu=index,name,temperature.gpu,clocks.gr,clocks.mem,power.draw,utilization.gpu,memory.used,memory.total \
        --format=csv,noheader,nounits 2>/dev/null | while IFS=',' read -r idx name temp core memclk power util mem_used mem_total; do
        
        # Trim whitespace
        idx=$(echo "$idx" | xargs)
        name=$(echo "$name" | xargs)
        temp=$(echo "$temp" | xargs)
        core=$(echo "$core" | xargs)
        memclk=$(echo "$memclk" | xargs)
        power=$(echo "$power" | xargs)
        util=$(echo "$util" | xargs)
        mem_used=$(echo "$mem_used" | xargs)
        mem_total=$(echo "$mem_total" | xargs)
        
        # Ultra-short GPU name
        name_short=$(echo "$name" | sed 's/NVIDIA //' | sed 's/GeForce //' | sed 's/RTX //' | cut -c1-12)
        
        # Color for temp
        if [ "$temp" -ge 80 ]; then
            tc="\033[1;31m"
        elif [ "$temp" -ge 70 ]; then
            tc="\033[1;33m"
        else
            tc="\033[1;32m"
        fi
        rc="\033[0m"
        
        # Display GPU status
        local gpu_status="${GPU_STATUS[$idx]:-online}"
        local online_time=${GPU_ONLINE_TIME[$idx]:-$SESSION_START}
        local total_uptime=${GPU_TOTAL_UPTIME[$idx]:-0}
        
        if [ "$gpu_status" = "online" ]; then
            local current_uptime=$((current_time - online_time))
            total_uptime=$((total_uptime + current_uptime))
            echo -n "GPU $idx: $name_short | Up: $(format_time $total_uptime)"
            tput el
            echo ""
            echo -n "  Online for $(format_time $current_uptime)"
            tput el
            echo ""
        else
            local fail_time=${GPU_FAIL_TIME[$idx]:-$current_time}
            local time_since_fail=$((current_time - fail_time))
            echo -n "GPU $idx: $name_short | Up: $(format_time $total_uptime)"
            tput el
            echo ""
            printf "  \033[1;31mFailed $(format_time $time_since_fail) ago\033[0m"
            tput el
            echo ""
        fi
        
        printf "  ${tc}%s°C${rc} | %sMHz/%sMHz | %sW | %s%%" \
            "$temp" "$core" "$memclk" "$power" "$util"
        tput el
        echo ""
        printf "  Mem: %sMB/%sMB" "$mem_used" "$mem_total"
        tput el
        echo ""
        
        # Get PIDs and process info with memory
        PID_INFO=$(nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader -i "$idx" 2>/dev/null)
        if [ -n "$PID_INFO" ]; then
            echo "$PID_INFO" | while IFS=',' read -r pid proc_name proc_mem; do
                pid=$(echo "$pid" | xargs)
                proc_name=$(echo "$proc_name" | xargs)
                proc_mem=$(echo "$proc_mem" | xargs)
                
                # Get working directory
                if [ -d "/proc/$pid" ]; then
                    cwd=$(readlink /proc/$pid/cwd 2>/dev/null || echo "")
                    if [ -n "$cwd" ]; then
                        printf "  PID %s (%sMB): %s" "$pid" "$proc_mem" "$cwd"
                        tput el
                        echo ""
                    else
                        printf "  PID %s (%sMB): %s" "$pid" "$proc_mem" "$proc_name"
                        tput el
                        echo ""
                    fi
                else
                    printf "  PID %s (%sMB): %s" "$pid" "$proc_mem" "$proc_name"
                    tput el
                    echo ""
                fi
            done
        else
            echo -n "  PIDs: -"
            tput el
            echo ""
        fi
        tput el
        echo ""
    done
    
    echo -n "Ctrl+C to exit"
    tput el
    echo ""
    # Clear any remaining lines
    tput ed
}

trap 'tput cnorm; clear; exit' INT TERM

tput civis

# Clear screen once at start
clear

# Main loop
while true; do
    check_gpu_health
    log_to_csv
    show_gpus
    sleep "$INTERVAL"
done
